POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{loginEmail}}",
  "password": "{{loginPassword}}"
}

### 2 MB request body — EXPECTED: 413
# Replace {{largePayload}} with a locally generated 2 MB JSON body.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{{largePayload}}

### Generic 500 response — EXPECTED: 500
# Requires an isolated fixture or controlled test endpoint that throws an unexpected
# exception. No such endpoint is present in the application; do not induce this by
# corrupting production data.
GET {{baseUrl}}/api/test/unexpected-error

# Expected JSON properties:
# "status": 500
# "detail": "An unexpected error occurred."
# "errorCode": "INTERNAL_ERROR"
# "traceId": "<non-empty>"
# No stackTrace, SQL text, file paths, or exception details.

### Newly-created password hash format — EXPECTED: PASS/FAIL assertion, no HTTP status
# Requires a disposable registration fixture and a read-only database assertion:
# PASSWORD_HASH LIKE '$2%'. Never print the hash. Do not run the assertion against
# NEBRASDB_Step1 without explicit approval.

### Admin approval success and persisted audit fields — EXPECTED: 204 then PASS/FAIL
# Requires an isolated unapproved Investor with both company fields and an Admin token.
# After 204, verify IsApproved=true, ApprovedById=authenticated Admin ID, and
# ApprovedAt is non-null UTC. Never print contact fields or tokens.

### User list pagination maximum — EXPECTED: 400
GET {{baseUrl}}/api/users?pageSize=1000
Authorization: Bearer {{adminToken}}

### Required user fields and role projection — EXPECTED: 200
# Response must include role, isApproved, companyName, and companyRegistrationNumber.
GET {{baseUrl}}/api/users?pageNumber=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Admin deletes SuperAdmin — EXPECTED: 403
DELETE {{baseUrl}}/api/users/<superadmin-id>
Authorization: Bearer {{adminToken}}

### Admin updates SuperAdmin — EXPECTED: 403
PUT {{baseUrl}}/api/users/<superadmin-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Rejected",
  "email": "rejected@example.test",
  "phone": "0700003118"
}

### Admin deletes another Admin — EXPECTED: 403
DELETE {{baseUrl}}/api/users/<other-admin-id>
Authorization: Bearer {{adminToken}}

### User deletes own account — EXPECTED: 403
DELETE {{baseUrl}}/api/users/<own-user-id>
Authorization: Bearer {{validToken}}

### Full name at 70 characters — EXPECTED: 204
PUT {{baseUrl}}/api/users/<disposable-user-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "email": "step3-boundary@example.test",
  "phone": "0700003119"
}

### Full name at 150 characters — EXPECTED: 400
PUT {{baseUrl}}/api/users/<disposable-user-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "email": "step3-oversized-name@example.test",
  "phone": "0700003120"
}

### Password at 200 characters — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Oversized Password",
  "email": "step3-200-password@example.test",
  "phone": "0700003121",
  "password": "{{password200Characters}}",
  "roleId": 1
}

### Control character input — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Bad\u0001Name",
  "email": "step3-control@example.test",
  "phone": "0700003122",
  "password": "{{loginPassword}}",
  "roleId": 1
}
