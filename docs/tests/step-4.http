Authorization: Bearer {{adminToken}}

### A v1-verified land keeps its VerifiedAgainstCriterionId after a new criterion — EXPECTED: unchanged (S4-58)
# Result: PASS (DB unchanged; driver S4-58a, and S4-58b/c/d prove new lands evaluate against the new version)
# Business rule: verification stores the criterion id on the land; a later criterion
# version must not rewrite an existing snapshot. VerifyAsync also only runs for
# PendingVerification lands, so a Verified land is never re-evaluated.
GET {{baseUrl}}/api/lands/{{landId}}
Authorization: Bearer {{adminToken}}

### Document type delete of a type used by documents — EXPECTED: 409 (S4-59)
# Result: PASS (409; driver S4-59b. An unused type is deleted 204 first — driver S4-59a)
DELETE {{baseUrl}}/api/document-types/1
Authorization: Bearer {{adminToken}}

### Review a document on a Verified land — EXPECTED: 409 (no re-review workflow; decision D1)
# Result: PASS (409; driver S4-60)
PUT {{baseUrl}}/api/lands/{{landId}}/documents/{{documentId}}/review
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "approved": false, "note": "Re-review attempt." }

### Verify when no document type is required — EXPECTED: 409 (no vacuous verification; decision D2)
# Result: PASS (409; driver S4-61; both required flags were toggled off and restored by the
# driver's try/finally, independently confirmed: SUM(required) = 2 afterwards)
# Decision D2: if no document type has IsRequiredForVerification = true, verification
# would succeed without any evidence reviewed, so it is rejected as a business rule.
POST {{baseUrl}}/api/lands/{{landId}}/verify
Authorization: Bearer {{adminToken}}

### Change IsRequiredForVerification must not rewrite an existing Verified snapshot — EXPECTED: 200 (S4-62)
# Result: PASS (200; driver S4-62; DB DATA_VERIFIED_BY_ADMIN / VERIFIED_AGAINST_CRITERION_ID
# snapshot unchanged, flags restored). Code review: UpdateAsync changes only the document type
# row; it does not touch LANDS, so a Verified land keeps its recorded snapshot (decision D3).
PUT {{baseUrl}}/api/document-types/2
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{ "name": "EncumbranceStatement", "isRequiredForVerification": false }

### Numeric input that used to overflow the DB area column — EXPECTED: 400 (SEC-14, R-43)
# Result: PASS (400, driver R-43). The AreaDonum/UpdateLandRequest bound was 1,000,000,000
# while LANDS.AREA_DONUM is decimal(10,2) (max 99,999,999.99). A value in between passed
# DTO validation and then failed at the database as an arithmetic overflow (generic 500).
# The bound now matches the column; areaDonum at the column maximum 99,999,999.99 -> 201
# (driver R-44).
POST {{baseUrl}}/api/lands
Authorization: Bearer {{landlordToken}}
Content-Type: application/json

{
  "regionId": 2, "gridId": 2, "landNumber": "OVF-<stamp>", "village": "Village-A", "basin": "Basin-A",
  "parcelNumber": "POVF-<stamp>", "areaDonum": 200000000, "slopePercentage": 5, "distanceToGridKm": 10,
  "solarIrradiance": 6, "elevationM": 100
}

### pageNumber near Int32.Max — EXPECTED: 200 with an empty page (SEC-14, R-45)
# Result: PASS (200, driver R-45). (pageNumber-1)*pageSize used to overflow Int32, producing
# a negative SQL OFFSET that SQL Server rejects -> generic 500. The offset is now computed in
# 64-bit and an out-of-range page is returned as empty instead of erroring.
GET {{baseUrl}}/api/lands?pageNumber=2147483647&pageSize=50
Authorization: Bearer {{landlordToken}}

# --- Post-remediation regression coverage (driver %TEMP%\opencode\s4_regression.ps1) ---
# R-24..R-28 visibility convention: missing land/documents -> 404; another owner's
#          land/documents/eligibility -> 403. PASS.
# R-29..R-33 race: five parallel creates with the same parcel -> one 201, four 409,
#          no 500, no SQL/index text; DB holds one live row. PASS (UQ_LAND_LOCATION).
# R-34.1..3/R-35..R-37 race: three rounds of five parallel uploads on one land and
#          document type -> 15 persisted rows, 15 distinct versions, sequential 1-15. PASS.
# R-38..R-42 SEC-17 free text: a reject reason and a review note with a newline or tab
#          pass validation and then return 403 for a landlord; U+0001 is rejected 400. PASS.
# R-43..R-45 SEC-14 numeric bounds (see the two cases above). PASS.
# Latest full remediation rerun: regression 47 PASS / 0 FAIL.
