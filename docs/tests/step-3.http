@baseUrl = http://localhost:5181
@landlordPassword = <set-a-local-test-password>
@investorPassword = <set-a-local-test-password>
@invalidPassword = <set-a-wrong-password>
@landlordToken = <capture-from-landlord-login>
@investorToken = <capture-from-investor-login>
@adminToken = <capture-from-existing-admin-login>
@superAdminToken = <capture-from-existing-superadmin-login>
@investorId = <capture-from-investor-registration>
@password200Characters = <generate-exactly-200-characters-locally>
@missingUserId = 2147483647
@nonInvestorUserId = <use-an-existing-landlord-id>
@adminId = <capture-from-admin-token>
@superAdminId = <capture-from-superadmin-token>

# Fixture requirements:
# - Run only against an isolated disposable database or explicitly approved fixtures.
# - Do not reuse production credentials or print tokens/passwords/hashes.
# - Admin/SuperAdmin fixtures, an unapproved Investor, and a Landlord fixture are required
#   for the protected-user and approval requests below.
# - Replace angle-bracket placeholders locally; never commit real values.
# - Use syntactically valid credentials (password 10-128 chars, <=72 UTF-8 bytes, no
#   control characters); otherwise login/registration returns 400 before credentials
#   are checked, which would mask the authorization behavior under test.
# - The HTTPS profile is https://localhost:7265. Use it only when the local development
#   certificate is trusted by the HTTP client. Otherwise use this HTTP development URL;
#   do not weaken application TLS settings.

# F7 execution status (run against NEBRASDB_Step1 in Development, RateLimit__AuthPerMinute=5):
#   PASS     executed; the actual status matched the expectation below it
#   BLOCKED  not executed. NEBRASDB_Step1 has no Admin or Investor rows and its only
#            SuperAdmin does not match the configured test credentials, so every request
#            that needs an Admin/SuperAdmin token is unverified. Those expectations are
#            documented targets, not results.
#   NOT RUN  outside the F7 scope; documented but unverified
# PASS equivalents (same endpoint and expectation, executed with disposable s3f-* emails
# instead of the literal fixture emails in this file): register Landlord (200), login
# Landlord (200), unknown email vs wrong password (401, identical bodies), Landlord
# GET /api/users (403), and register with a soft-deleted user's email (409).

### Register Landlord — EXPECTED: 200
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Step 3 Test Landlord",
  "email": "step3-landlord@example.test",
  "phone": "0700003101",
  "password": "{{landlordPassword}}",
  "roleId": 1
}

### Register Investor — EXPECTED: 200
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Step 3 Test Investor",
  "email": "step3-investor@example.test",
  "phone": "0700003102",
  "password": "{{investorPassword}}",
  "roleId": 2,
  "companyName": "Step 3 Test Company",
  "companyRegistrationNumber": "STEP3-INVESTOR-001"
}

### Investor registration without company details — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Invalid Step 3 Investor",
  "email": "step3-invalid-investor@example.test",
  "phone": "0700003103",
  "password": "{{investorPassword}}",
  "roleId": 2
}

### Public Admin registration — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Rejected Public Admin",
  "email": "step3-public-admin@example.test",
  "phone": "0700003104",
  "password": "{{landlordPassword}}",
  "roleId": 3
}

### Public SuperAdmin registration — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Rejected Public SuperAdmin",
  "email": "step3-public-superadmin@example.test",
  "phone": "0700003105",
  "password": "{{landlordPassword}}",
  "roleId": 4
}

### Login Landlord — EXPECTED: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "step3-landlord@example.test",
  "password": "{{landlordPassword}}"
}

### Login Investor — EXPECTED: 200
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "step3-investor@example.test",
  "password": "{{investorPassword}}"
}

### Current user — EXPECTED: 200
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{landlordToken}}

### Unknown email — EXPECTED: 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "unknown-step3@example.test",
  "password": "{{invalidPassword}}"
}

### Wrong password — EXPECTED: 401; compare with unknown-email response without exposing bodies
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "step3-landlord@example.test",
  "password": "{{invalidPassword}}"
}

### Unauthenticated lands request — EXPECTED: 401
GET {{baseUrl}}/api/lands

### Landlord cannot list users — EXPECTED: 403
GET {{baseUrl}}/api/users
Authorization: Bearer {{landlordToken}}

### SuperAdmin lists users — EXPECTED: 200
GET {{baseUrl}}/api/users
Authorization: Bearer {{superAdminToken}}

### Paginated user list with filters — EXPECTED: 200
GET {{baseUrl}}/api/users?pageNumber=1&pageSize=20&role=Investor&isApproved=false
Authorization: Bearer {{superAdminToken}}

### User list page size above maximum — EXPECTED: 400
GET {{baseUrl}}/api/users?pageSize=1000
Authorization: Bearer {{superAdminToken}}

### Invalid user role filter — EXPECTED: 400
GET {{baseUrl}}/api/users?role=NotARealRole
Authorization: Bearer {{superAdminToken}}

### Admin approves valid Investor — EXPECTED: 204
# Requires an unapproved Investor with both company fields and an Admin token.
POST {{baseUrl}}/api/users/{{investorId}}/approve
Authorization: Bearer {{adminToken}}

### Verify approval with Admin user listing — EXPECTED: 200
# Inspect only IsApproved, ApprovedById, and ApprovedAt; redact all contacts/tokens.
GET {{baseUrl}}/api/users/{{investorId}}
Authorization: Bearer {{adminToken}}

### Missing-user approval — EXPECTED: 404
POST {{baseUrl}}/api/users/{{missingUserId}}/approve
Authorization: Bearer {{adminToken}}

### Non-Investor approval — EXPECTED: 400
POST {{baseUrl}}/api/users/{{nonInvestorUserId}}/approve
Authorization: Bearer {{adminToken}}

### Investor missing company details approval — EXPECTED: 400
# Requires a disposable unapproved Investor fixture missing one company field.
POST {{baseUrl}}/api/users/<investor-missing-company-id>/approve
Authorization: Bearer {{adminToken}}

### Admin attempts to delete SuperAdmin — EXPECTED: 403
DELETE {{baseUrl}}/api/users/{{superAdminId}}
Authorization: Bearer {{adminToken}}

### Admin attempts to update SuperAdmin — EXPECTED: 403
PUT {{baseUrl}}/api/users/{{superAdminId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Rejected Update",
  "email": "rejected-update@example.test",
  "phone": "0700003111"
}

### Admin attempts to delete another Admin — EXPECTED: 403
DELETE {{baseUrl}}/api/users/<other-admin-id>
Authorization: Bearer {{adminToken}}

### Admin attempts to delete own account — EXPECTED: 403
# Self-management protection lives in UserService.EnsureCallerCanManage. A Landlord
# token is rejected earlier by the class-level [Authorize(Roles=Admin,SuperAdmin)]
# (also 403), so exercise this rule with an Admin/SuperAdmin token and its own id.
DELETE {{baseUrl}}/api/users/{{adminId}}
Authorization: Bearer {{adminToken}}

### SuperAdmin deletes disposable Admin fixture — EXPECTED: 204
# Requires a disposable Admin created during this test run; otherwise BLOCKED.
DELETE {{baseUrl}}/api/users/<disposable-admin-id>
Authorization: Bearer {{superAdminToken}}

### Valid 70-character full name update — EXPECTED: 204
PUT {{baseUrl}}/api/users/<disposable-landlord-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "email": "step3-update@example.test",
  "phone": "0700003112"
}

### 150-character full name update — EXPECTED: 400
PUT {{baseUrl}}/api/users/<disposable-landlord-id>
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "email": "step3-update@example.test",
  "phone": "0700003112"
}

### 200-character registration password — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Oversized Password User",
  "email": "step3-oversized-password@example.test",
  "phone": "0700003113",
  "password": "{{password200Characters}}",
  "roleId": 1
}

### Control character in full name — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Invalid\u0001Name",
  "email": "step3-control-character@example.test",
  "phone": "0700003114",
  "password": "{{landlordPassword}}",
  "roleId": 1
}

### Tampered JWT — EXPECTED: 401
# Set tamperedToken locally by changing one character of a valid token.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer <tamperedToken>

### alg:none JWT — EXPECTED: 401
# Supply a locally generated unsigned token; never commit or print it.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer <unsigned-token>

### Query-string access_token — EXPECTED: 401
GET {{baseUrl}}/api/auth/me?access_token=<valid-token>

### Deactivated user's old token — EXPECTED: 401
# Requires a disposable user: capture its token, soft-delete it as Admin, then retry.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer <deactivated-user-old-token>

### Token after database role change — EXPECTED: 401
# Requires a disposable user: capture its token, change its DB role in an approved
# isolated fixture, then retry. Do not perform this against NEBRASDB_Step1.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer <role-changed-user-old-token>

### Auth registration with extra protected fields — EXPECTED: 200
# Use roleId 2 (Investor) because a Landlord is approved by default and cannot
# demonstrate that the rejected isApproved field had no effect. Extra fields must not
# set IsApproved, IsDeleted, ApprovedById, ApprovedAt, or PasswordHash, and must not
# elevate the role.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Extra Field Investor",
  "email": "step3-extra-fields@example.test",
  "phone": "0700003106",
  "password": "{{investorPassword}}",
  "roleId": 2,
  "companyName": "Extra Field Co",
  "companyRegistrationNumber": "STEP3-EXTRA-01",
  "isApproved": true,
  "isDeleted": true,
  "approvedById": 4,
  "approvedAt": "2030-01-01T00:00:00Z",
  "passwordHash": "not-a-hash"
}

### Verify mass assignment had no effect — EXPECTED: 200, role=Investor, isApproved=false
# Log in with the account from the previous request and call this; a successful login
# proves isDeleted was ignored, and isApproved must remain false.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer <token-from-the-registration-above>

### Auth registration with Admin role plus protected fields — EXPECTED: 400
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Extra Field Admin",
  "email": "step3-extra-admin@example.test",
  "phone": "0700003107",
  "password": "{{landlordPassword}}",
  "roleId": 3,
  "isApproved": true
}

### Admin create user with protected fields — EXPECTED: 201
# Requires Admin/SuperAdmin token. Use roleId 2 (Investor) so isApproved can be
# observed as false; a Landlord is approved by default. Inspect the created response:
# no PasswordHash or protected fields may be returned.
POST {{baseUrl}}/api/users
Authorization: Bearer {{superAdminToken}}
Content-Type: application/json

{
  "fullName": "Extra Field API Investor",
  "email": "step3-extra-user@example.test",
  "phone": "0700003108",
  "password": "{{investorPassword}}",
  "roleId": 2,
  "companyName": "Extra Field API Co",
  "companyRegistrationNumber": "STEP3-API-01",
  "isApproved": true,
  "isDeleted": true,
  "approvedById": 4,
  "approvedAt": "2030-01-01T00:00:00Z",
  "passwordHash": "not-a-hash"
}

