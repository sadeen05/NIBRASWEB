{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "nibras-api",
    "Audience": "nibras-web",
    "ExpiryMinutes": 120
  },
  "RateLimit": {
    "AuthPerMinute": 10,
    "ActivationPerMinute": 5,
    "VerificationPerMinute": 5,
    "VerificationResendPerMinute": 5,
    "EmailChangePerMinute": 5
  },
  "Documents": {
    "StorageRoot": "",
    "MaxFileSizeBytes": 10485760
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Email": {
    "DeliveryMode": "Disabled",
    "FromAddress": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpEnableSsl": true,
    "SmtpUser": "",
    "SmtpPassword": "",
    "OutboxPath": "",
    "FrontendBaseUrl": "",
    "ActivationPath": "/activate-admin",
    "VerificationPath": "/verify-email",
    "EmailChangePath": "/confirm-email-change",
    "RegistrationTokenTtlHours": 24,
    "EmailChangeTokenTtlHours": 1,
    "AdminActivationTokenTtlHours": 24,
    "ResendCooldownSeconds": 60,
    "ResendDailyCap": 10
  },
  "Grid": {
    "HoldDays": 90
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}